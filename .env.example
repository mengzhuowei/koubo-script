# ===========================================
# 口播雷达 环境变量配置
# ===========================================
# 使用方法：
#   本地运行：复制本文件为 .env，填入实际值后 python app.py
#   本地启用项目助手：安装 Node.js 22.19+，运行 npm ci --prefix pi-agent --ignore-scripts
#   Docker 运行：同样复制为 .env，docker compose 会自动读取并注入容器
#   注意：.env 已被 .dockerignore 排除，不会打进镜像，密钥安全
#
# 数据库部署说明：
#   MySQL 不再随容器启动，需要在宿主机（或另一台机器）单独部署 MySQL 8.0+。
#   本地直连：DB_HOST 用 127.0.0.1；容器内连接宿主机 MySQL：DB_HOST 用 host.docker.internal
#   首次部署需要手动建库建用户（容器不再自动建库）：
#     mysql -u root -p -e "CREATE DATABASE koubo CHARACTER SET utf8mb4;"
#     mysql -u root -p -e "CREATE USER 'koubo'@'%' IDENTIFIED BY 'koubo'; GRANT ALL ON koubo.* TO 'koubo'@'%';"
#     mysql -u root -p -e "FLUSH PRIVILEGES;"
#   MySQL 端 bind-address 需要设为 0.0.0.0（默认 127.0.0.1 容器访问不到）

# ---------- 应用 ----------
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# Docker 运行时 compose 会覆盖为 0.0.0.0
# 本地运行保持 127.0.0.1 即可

# ---------- 数据库（MySQL）----------
# 本地运行（python app.py）：DB_HOST=127.0.0.1
# Docker 运行：docker-compose.yml 会把 DB_HOST 强制覆盖为 host.docker.internal
# 远端 MySQL：直接写 IP/域名，如 DB_HOST=192.168.1.100
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=koubo
DB_PASSWORD=koubo
DB_NAME=koubo

# ---------- LLM ----------
# OpenAI API Key（必填才能用 LLM 功能；留空则内容卡/选题评分/脚本生成不可用，应用不崩溃）
OPENAI_API_KEY=
# 兼容 OpenAI 协议的第三方接口地址（可选，如 Azure OpenAI、国产兼容网关）
OPENAI_BASE_URL=https://api.openai.com/v1

# 首次启动初始化 llm_settings 用，之后以设置页保存的配置为准
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o-mini

# ---------- 抓取 ----------
# 建议使用浏览器 UA，避免被 SSR 站点（如 InfoQ）当作爬虫返回空壳 HTML
FETCH_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# ---------- 后台任务 ----------
JOB_HEARTBEAT_TIMEOUT_SECONDS=300
JOB_POLL_INTERVAL_SECONDS=2.0

# ---------- 定时调度 ----------
# 总开关：关闭则不自动抓取，只能手动点"抓取全部"
SCHEDULER_ENABLED=true
# 调度器轮询间隔（分钟）：每隔多久检查一次到期来源并入队抓取
SCHEDULER_FETCH_CHECK_INTERVAL_MINUTES=30
# 选题自动生成开关：默认关闭，开启后会按 cron 自动创建 generate_topic 任务（消耗 LLM）
SCHEDULER_TOPIC_ENABLED=false
# 选题自动生成 cron（5 字段：分 时 日 月 周），默认每天 09:30
SCHEDULER_TOPIC_CRON=30 9 * * *

# ---------- 日志 ----------
# INFO=只看关键流程（默认）；DEBUG=看每篇文章的新增/去重/回抓明细
LOG_LEVEL=INFO

# ---------- 联网搜索（V0.3，默认关闭）----------
# 总开关：关闭后系统不会发起联网搜索，只用本地文章库生成资料卡
WEB_SEARCH_ENABLED=false
# 搜索 provider，目前只支持 tavily
WEB_SEARCH_PROVIDER=tavily
# Tavily API Key（在 https://tavily.com 注册获取，免费档 1000 credits/月）
TAVILY_API_KEY=
# 搜索深度：basic=1 credit/次，advanced=2 credits/次（advanced 返回更详细内容）
TAVILY_SEARCH_DEPTH=basic
# 每次搜索返回结果数上限
TAVILY_MAX_RESULTS=10
# Extract 提取正文的最大 URL 数（每 5 个 URL 约 1 credit）
TAVILY_EXTRACT_MAX_URLS=5
# 月度 credit 预算上限（免费档 1000，默认预留 200 安全余量）
TAVILY_MONTHLY_CREDIT_BUDGET=800
# 单个选题最大 credit 消耗（防止一次选题烧太多额度）
TAVILY_PER_TOPIC_CREDIT_BUDGET=3
