# 口播雷达 MVP Docker Compose
# 使用方法：
#   1. 宿主机先启动 MySQL（默认 3306 端口，库名 koubo，用户 koubo/koubo）
#   2. 在项目根目录创建 .env 文件，至少配置 OPENAI_API_KEY=sk-xxx（可选，缺则 LLM 功能不可用）
#   3. 复制本文件为 docker-compose.yml：cp docker-compose.yml.example docker-compose.yml
#   4. docker compose up -d --build
#   5. 浏览器访问 http://127.0.0.1:8000
#
# 网络模型：app 容器通过 host.docker.internal 访问宿主机上的 MySQL，
# 不再内置 mysql 服务。MySQL 由宿主/外置部署负责，容器只跑应用。
services:
  app:
    build: .
    image: koubo-script:latest
    container_name: koubo-script
    restart: unless-stopped
    ports:
      - "8000:8000"
    # 从宿主 .env 读取配置注入容器；未定义的变量用默认值
    environment:
      APP_HOST: "0.0.0.0"
      APP_PORT: "8000"
      # 访问宿主机上的 MySQL：Docker Desktop (Windows/Mac) 自带 host.docker.internal 解析
      # Linux 上需额外加 extra_hosts（见下方）把 host-gateway 映射到 host.docker.internal
      # 可在 .env 里用 DB_HOST 覆盖（如 DB_HOST=mysql 走另一个容器 / DB_HOST=192.168.1.100 走远端）
      DB_HOST: ${DB_HOST:-host.docker.internal}
      DB_PORT: ${DB_PORT:-3306}
      DB_USER: ${DB_USER:-koubo}
      DB_PASSWORD: ${DB_PASSWORD:-koubo}
      DB_NAME: ${DB_NAME:-koubo}
      OPENAI_API_KEY: ${OPENAI_API_KEY:-}
      OPENAI_BASE_URL: ${OPENAI_BASE_URL:-}
      DEFAULT_LLM_PROVIDER: ${DEFAULT_LLM_PROVIDER:-openai}
      DEFAULT_LLM_MODEL: ${DEFAULT_LLM_MODEL:-gpt-4o-mini}
      FETCH_USER_AGENT: ${FETCH_USER_AGENT:-Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36}
      JOB_HEARTBEAT_TIMEOUT_SECONDS: ${JOB_HEARTBEAT_TIMEOUT_SECONDS:-300}
      JOB_POLL_INTERVAL_SECONDS: ${JOB_POLL_INTERVAL_SECONDS:-2.0}
      SCHEDULER_ENABLED: ${SCHEDULER_ENABLED:-true}
      SCHEDULER_FETCH_CHECK_INTERVAL_MINUTES: ${SCHEDULER_FETCH_CHECK_INTERVAL_MINUTES:-30}
      SCHEDULER_TOPIC_ENABLED: ${SCHEDULER_TOPIC_ENABLED:-false}
      SCHEDULER_TOPIC_CRON: ${SCHEDULER_TOPIC_CRON:-30 9 * * *}
      WEB_SEARCH_ENABLED: ${WEB_SEARCH_ENABLED:-false}
      WEB_SEARCH_PROVIDER: ${WEB_SEARCH_PROVIDER:-tavily}
      TAVILY_API_KEY: ${TAVILY_API_KEY:-}
      TAVILY_SEARCH_DEPTH: ${TAVILY_SEARCH_DEPTH:-basic}
      TAVILY_MAX_RESULTS: ${TAVILY_MAX_RESULTS:-10}
      TAVILY_EXTRACT_MAX_URLS: ${TAVILY_EXTRACT_MAX_URLS:-5}
      TAVILY_MONTHLY_CREDIT_BUDGET: ${TAVILY_MONTHLY_CREDIT_BUDGET:-800}
      TAVILY_PER_TOPIC_CREDIT_BUDGET: ${TAVILY_PER_TOPIC_CREDIT_BUDGET:-3}
      LOG_LEVEL: ${LOG_LEVEL:-INFO}
      TZ: Asia/Shanghai
    extra_hosts:
      # Windows/Mac Docker Desktop 默认已支持；显式声明便于 Linux 部署兼容
      - "host.docker.internal:host-gateway"
    volumes:
      # 容器时区与宿主机对齐
      - /etc/localtime:/etc/localtime:ro
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz')"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s
    # app 与外部 MySQL 容器共享同一网络（koubo-net），通过容器名/服务名直接解析
    networks:
      - koubo-net

# 显式网络：name 固定，多个 compose 共用同一网络
networks:
  koubo-net:
    name: koubo-net
    driver: bridge
