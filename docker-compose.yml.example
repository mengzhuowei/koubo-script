# 口播雷达 MVP Docker Compose
# 使用方法：
#   1. 在项目根目录创建 .env 文件，至少配置 OPENAI_API_KEY=sk-xxx（可选，缺则 LLM 功能不可用）
#   2. docker compose up -d --build
#   3. 浏览器访问 http://127.0.0.1:8000
services:
  mysql:
    image: mysql:8.0
    container_name: koubo-mysql
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD:-rootpass}
      MYSQL_DATABASE: ${MYSQL_DATABASE:-koubo}
      MYSQL_USER: ${MYSQL_USER:-koubo}
      MYSQL_PASSWORD: ${MYSQL_PASSWORD:-koubo}
      TZ: Asia/Shanghai
    volumes:
      # MySQL 数据持久化到宿主机 ./data/mysql，重启/重建容器数据不丢失
      - ./data/mysql:/var/lib/mysql
      # 容器时区与宿主机对齐：日志 NOW()/CURRENT_TIMESTAMP 全部按 Asia/Shanghai
      - /etc/localtime:/etc/localtime:ro
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "127.0.0.1", "-u", "root", "-p${MYSQL_ROOT_PASSWORD:-rootpass}"]
      interval: 5s
      timeout: 5s
      retries: 20
      start_period: 20s
    # 如需宿主直接连 MySQL 调试，取消注释下一行
    # ports:
    #   - "3306:3306"

  app:
    build: .
    image: koubo-script:latest
    container_name: koubo-script
    restart: unless-stopped
    depends_on:
      mysql:
        condition: service_healthy
    ports:
      - "8000:8000"
    # 从宿主 .env 读取配置注入容器；未定义的变量用默认值
    environment:
      APP_HOST: "0.0.0.0"
      APP_PORT: "8000"
      DB_HOST: mysql
      DB_PORT: "3306"
      DB_USER: ${MYSQL_USER:-koubo}
      DB_PASSWORD: ${MYSQL_PASSWORD:-koubo}
      DB_NAME: ${MYSQL_DATABASE:-koubo}
      OPENAI_API_KEY: ${OPENAI_API_KEY:-}
      OPENAI_BASE_URL: ${OPENAI_BASE_URL:-}
      DEFAULT_LLM_PROVIDER: ${DEFAULT_LLM_PROVIDER:-openai}
      DEFAULT_LLM_MODEL: ${DEFAULT_LLM_MODEL:-gpt-4o-mini}
      FETCH_USER_AGENT: ${FETCH_USER_AGENT:-AgentScriptRadar/0.1}
      JOB_HEARTBEAT_TIMEOUT_SECONDS: ${JOB_HEARTBEAT_TIMEOUT_SECONDS:-300}
      JOB_POLL_INTERVAL_SECONDS: ${JOB_POLL_INTERVAL_SECONDS:-2.0}
      SCHEDULER_ENABLED: ${SCHEDULER_ENABLED:-true}
      SCHEDULER_FETCH_CHECK_INTERVAL_MINUTES: ${SCHEDULER_FETCH_CHECK_INTERVAL_MINUTES:-30}
      SCHEDULER_TOPIC_ENABLED: ${SCHEDULER_TOPIC_ENABLED:-false}
      SCHEDULER_TOPIC_CRON: ${SCHEDULER_TOPIC_CRON:-30 9 * * *}
      LOG_LEVEL: ${LOG_LEVEL:-INFO}
      TZ: Asia/Shanghai
    volumes:
      # 容器时区与宿主机对齐
      - /etc/localtime:/etc/localtime:ro
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz')"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s
